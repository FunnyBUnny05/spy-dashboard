{
  "name": "spy-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"vite\" \"cross-env NODE_ENV=development electron .\"",
    "build": "tsc -b && vite build",
    "write-source-path": "node -e \"const fs=require('fs');fs.writeFileSync('electron/source-path.json',JSON.stringify({path:process.cwd()}))\"",
    "build:app": "npm run write-source-path && npm run build && electron-builder",
    "preview": "vite preview",
    "update-aaii": "python3 scripts/update_aaii.py",
    "lint": "eslint ."
  },
  "dependencies": {
    "chart.js": "^4.4.1",
    "chokidar": "^3.6.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.0.0",
    "cross-env": "^7.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  },
  "build": {
    "appId": "com.user.spy-dashboard",
    "productName": "SPY Dashboard",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dir"
    }
  }
}
